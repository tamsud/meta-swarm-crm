# Backend environment variables
# Copy this file to .env and update values as needed

# Database connection string (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./crm.db

# JWT Authentication (change in production!)
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
